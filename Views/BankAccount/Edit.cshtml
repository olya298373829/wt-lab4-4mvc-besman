@model wt_lab4_4mvc_besman.Models.BankAccount

@{
    ViewData["Title"] = "Редактировать счёт";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm rounded-4 border-0 p-4">
                <h2 class="mb-4 fw-bold text-center">Редактирование счёта</h2>
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="mb-3">
                        <label asp-for="Owner" class="form-label">ФИО владельца</label>
                        <input asp-for="Owner" class="form-control rounded-3" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="AccountNumber" class="form-label">Номер счёта</label>
                        <input asp-for="AccountNumber" class="form-control rounded-3" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Balance" class="form-label">Баланс</label>
                        <input asp-for="Balance" class="form-control rounded-3" type="number" step="0.01" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Currency" class="form-label">Валюта</label>
                        <select asp-for="Currency" class="form-select rounded-3">
                            <option value="BYN">BYN</option>
                            <option value="USD">USD</option>
                            <option value="EUR">EUR</option>
                            <option value="RUB">RUB</option>
                        </select>
                    </div>
                    <div class="form-check mb-4">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="IsActive" class="form-check-label">Счёт активен</label>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary rounded-3 w-100">Сохранить изменения</button>
                        <a asp-action="Index" class="btn btn-secondary rounded-3 w-100">Назад</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>